<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The training mode (AGENTS.md, 3; development plan, phase 7): the quiz of the symbols, the abbreviations, the
         waypoints and the danger marks of a catalogue, and the reading of the boxes of junctions of random routes, their
         questions drawn from a seed. Pure Java: the domain model, the catalogues, whose groups of similar elements it
         reads, the routing, through the interface Router only, and the roadbook, which turns the routes into boxes; it
         draws nothing itself. No JavaFX. -->
    <parent>
        <groupId>ch.varani.boxone</groupId>
        <artifactId>box-one</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box-one-training</artifactId>
    <name>Box One training</name>

    <properties>
        <root.dir>${project.basedir}/..</root.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-core</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-catalog</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-routing</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-roadbook</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!-- The small extract of OpenStreetMap of the tests of the routing, shared rather than copied: junctions are
                 read on routes drawn on it by GraphHopper (AGENTS.md, 6). -->
            <testResource>
                <directory>${root.dir}/routing/src/test/resources</directory>
            </testResource>
        </testResources>
    </build>

</project>
