<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The roadbook (AGENTS.md, 3): a route turned into the boxes of a roadbook, with their total and partial
         distances and their heading (development plan, phase 2). Pure Java: no dependency but the domain model. -->
    <parent>
        <groupId>ch.varani.boxone</groupId>
        <artifactId>box-one</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box-one-roadbook</artifactId>
    <name>Box One roadbook</name>

    <properties>
        <root.dir>${project.basedir}/..</root.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-core</artifactId>
        </dependency>

        <!-- The collection of reference routes (AGENTS.md, 2): the routes of the tests are computed by GraphHopper on
             the small extract of the routing, so that the boxes are the ones of real junctions. Tests only: the
             roadbook itself reads no routing engine. -->
        <dependency>
            <groupId>ch.varani.boxone</groupId>
            <artifactId>box-one-routing</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <!-- The small extract of OpenStreetMap of the tests of the routing, shared rather than copied: the
                 reference routes are computed on it by GraphHopper (AGENTS.md, 6). -->
            <testResource>
                <directory>${root.dir}/routing/src/test/resources</directory>
            </testResource>
        </testResources>
    </build>

</project>
