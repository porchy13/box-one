<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Complete test file: distances, headings, start and finish of the stage, a WPM, a danger and drawn tulips.
  Box One, phase 0 (doc/box-one-plan-developpement.md): file written for the import test in Terra Pirata.
  Format: GPX 1.1 with the OpenRally extensions v1.0.3 (cross-country/openrally.xsd of github.com/openrally/openrally).
  Places: public streets of Yverdon-les-Bains, approximate positions. Distances (km) and headings (degrees) computed
  as the crow flies between the points: the file tests the import, it is not a route to ride.
-->
<gpx xmlns="http://www.topografix.com/GPX/1/1" creator="Box One (phase 0, written by hand)" version="1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:openrally="http://www.openrally.org/xmlschemas/GpxExtensions/v1.0.3"
  xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd
                      http://www.openrally.org/xmlschemas/GpxExtensions/v1.0.3 openrally.xsd">

  <metadata>
    <name>Box One - complete test</name>
    <copyright author="OpenStreetMap contributors">
      <license>https://opendatacommons.org/licenses/odbl/</license>
    </copyright>
    <extensions>
      <openrally:units>metric</openrally:units>
      <openrally:distance>1.27</openrally:distance>
    </extensions>
  </metadata>

  <wpt lat="46.77830" lon="6.64130">
    <name>1</name>
    <desc>Départ</desc>
    <extensions>
      <openrally:distance>0.00</openrally:distance>
      <openrally:cap>53</openrally:cap>
      <openrally:dss/>
      <openrally:tulip><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><g fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M50 90 L50 50 L50.0 12.0"/><path d="M54.8 20.8 L50.0 12.0 L45.2 20.8"/></g><circle cx="50" cy="90" r="5" fill="black"/></svg>]]></openrally:tulip>
      <openrally:notes><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><text x="50" y="55" font-family="sans-serif" font-size="14" text-anchor="middle">Départ</text></svg>]]></openrally:notes>
    </extensions>
  </wpt>

  <wpt lat="46.78010" lon="6.64480">
    <name>2</name>
    <desc>Carrefour 1</desc>
    <extensions>
      <openrally:distance>0.33</openrally:distance>
      <openrally:cap>24</openrally:cap>
      <openrally:danger>1</openrally:danger>
      <openrally:tulip><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><g fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M50 90 L50 50 L31.6 16.8"/><path d="M40.0 22.1 L31.6 16.8 L31.6 26.8"/></g><circle cx="50" cy="90" r="5" fill="black"/></svg>]]></openrally:tulip>
      <openrally:notes><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><text x="50" y="55" font-family="sans-serif" font-size="14" text-anchor="middle">Carrefour 1</text></svg>]]></openrally:notes>
    </extensions>
  </wpt>

  <wpt lat="46.78350" lon="6.64700">
    <name>3</name>
    <desc>Carrefour 2</desc>
    <extensions>
      <openrally:distance>0.75</openrally:distance>
      <openrally:cap>41</openrally:cap>
      <openrally:wpm open="800" clear="90" name="1"/>
      <openrally:tulip><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><g fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M50 90 L50 50 L61.1 13.7"/><path d="M63.1 23.5 L61.1 13.7 L54.0 20.7"/></g><circle cx="50" cy="90" r="5" fill="black"/></svg>]]></openrally:tulip>
      <openrally:notes><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><text x="50" y="55" font-family="sans-serif" font-size="14" text-anchor="middle">Carrefour 2</text></svg>]]></openrally:notes>
    </extensions>
  </wpt>

  <wpt lat="46.78700" lon="6.65150">
    <name>4</name>
    <desc>Arrivée</desc>
    <extensions>
      <openrally:distance>1.27</openrally:distance>
      <openrally:ass/>
      <openrally:tulip><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><g fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M50 90 L50 50 L50.0 12.0"/><path d="M54.8 20.8 L50.0 12.0 L45.2 20.8"/></g><circle cx="50" cy="90" r="5" fill="black"/></svg>]]></openrally:tulip>
      <openrally:notes><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><text x="50" y="55" font-family="sans-serif" font-size="14" text-anchor="middle">Arrivée</text></svg>]]></openrally:notes>
    </extensions>
  </wpt>

  <trk>
    <name>Box One - trace</name>
    <trkseg>
      <trkpt lat="46.77830" lon="6.64130"/>
      <trkpt lat="46.78010" lon="6.64480"/>
      <trkpt lat="46.78350" lon="6.64700"/>
      <trkpt lat="46.78700" lon="6.65150"/>
    </trkseg>
  </trk>
</gpx>
