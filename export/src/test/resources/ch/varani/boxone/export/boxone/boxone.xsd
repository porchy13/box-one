<?xml version="1.0" encoding="UTF-8"?>
<!--
  The route of Box One (issue #5 of GitLab), version 1 of its format: an extension of the metadata of a roadbook
  exported as GPX 1.1 with the extensions of OpenRally v1.0.3, so that Box One can open the roadbook again. Written by
  OpenRallyWriter, read by OpenRallyReader; the strict schema of the tests (boxone-strict.xsd) validates every file
  exported against it.

  route: the version of the format (formatVersion), the distance of the route in metres, its duration (xs:duration)
  and the indices of its maneuvers among the points of the track (trk), in increasing order;
  start, finish: the places clicked, in WGS 84;
  detour (only for a detour): its seed, its budget (unit and amount), the kinds of road it avoids and the duration of
  the fastest route;
  edits (only if the user changed the roadbook, development plan, phase 5): the places of the boxes added (added) and
  removed (removed), and the corrections of the boxes at their places (box): the shift of the total distance in metres,
  the heading typed in degrees (absent for the heading computed), whether the heading is shown (display), and the
  tulip corrected (tulip), after the tulip generated it replaces (generated): the shape of the junction, the kind of
  the entry, the angles of the branches in degrees clockwise from straight ahead, their kinds, and the index of the
  exit among them.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="urn:ch.varani.boxone:roadbook"
            targetNamespace="urn:ch.varani.boxone:roadbook"
            elementFormDefault="qualified">

  <xsd:element name="route">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="start" type="pointType"/>
        <xsd:element name="finish" type="pointType"/>
        <xsd:element name="detour" type="detourType" minOccurs="0"/>
        <xsd:element name="edits" type="editsType" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="formatVersion" type="xsd:positiveInteger" use="required"/>
      <xsd:attribute name="distance" type="nonNegativeDouble" use="required"/>
      <xsd:attribute name="duration" type="xsd:duration" use="required"/>
      <xsd:attribute name="maneuvers" type="indicesType" use="required"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:complexType name="pointType">
    <xsd:attribute name="lat" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:decimal">
          <xsd:minInclusive value="-90"/>
          <xsd:maxInclusive value="90"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="lon" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:decimal">
          <xsd:minInclusive value="-180"/>
          <xsd:maxInclusive value="180"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
  </xsd:complexType>

  <xsd:complexType name="detourType">
    <xsd:attribute name="seed" type="xsd:long" use="required"/>
    <xsd:attribute name="budgetUnit" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:token">
          <xsd:enumeration value="MINUTES"/>
          <xsd:enumeration value="PERCENT"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="budget" type="xsd:nonNegativeInteger" use="required"/>
    <xsd:attribute name="avoided">
      <xsd:simpleType>
        <xsd:list>
          <xsd:simpleType>
            <xsd:restriction base="xsd:token">
              <xsd:enumeration value="MOTORWAY"/>
              <xsd:enumeration value="TRUNK"/>
              <xsd:enumeration value="FERRY"/>
              <xsd:enumeration value="TOLL"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:list>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="fastest" type="xsd:duration" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="editsType">
    <xsd:sequence>
      <xsd:element name="added" type="pointType" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:element name="removed" type="pointType" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:element name="box" type="boxType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="boxType">
    <xsd:complexContent>
      <xsd:extension base="pointType">
        <xsd:sequence>
          <xsd:sequence minOccurs="0">
            <xsd:element name="generated" type="tulipType"/>
            <xsd:element name="tulip" type="tulipType"/>
          </xsd:sequence>
          <xsd:element name="notes" type="notesType" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="shift" type="xsd:double" use="required"/>
        <xsd:attribute name="heading">
          <xsd:simpleType>
            <xsd:restriction base="xsd:int">
              <xsd:minInclusive value="0"/>
              <xsd:maxInclusive value="359"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:attribute>
        <xsd:attribute name="display" use="required">
          <xsd:simpleType>
            <xsd:restriction base="xsd:token">
              <xsd:enumeration value="RULE"/>
              <xsd:enumeration value="SHOWN"/>
              <xsd:enumeration value="HIDDEN"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:attribute>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="notesType">
    <xsd:sequence>
      <xsd:element name="symbol" minOccurs="0" maxOccurs="8">
        <xsd:complexType>
          <xsd:attribute name="name" use="required">
            <xsd:simpleType>
              <xsd:restriction base="xsd:token">
                <xsd:enumeration value="RAIL_ROAD"/>
                <xsd:enumeration value="BUMP"/>
                <xsd:enumeration value="DIP_HOLE"/>
                <xsd:enumeration value="COMPRESSION"/>
                <xsd:enumeration value="DITCH"/>
                <xsd:enumeration value="SUMMIT"/>
                <xsd:enumeration value="ABOVE_BRIDGE"/>
                <xsd:enumeration value="UNDER_BRIDGE"/>
                <xsd:enumeration value="STEP_UP"/>
                <xsd:enumeration value="STEP_DOWN"/>
                <xsd:enumeration value="FENCE_GATE"/>
                <xsd:enumeration value="CATTLE_GATE"/>
                <xsd:enumeration value="WALL_GATE"/>
                <xsd:enumeration value="WADING"/>
                <xsd:enumeration value="CONCRETE_PASS"/>
                <xsd:enumeration value="TUNNEL"/>
                <xsd:enumeration value="UP_HILL"/>
                <xsd:enumeration value="DOWN_HILL"/>
                <xsd:enumeration value="CUT_DANGER"/>
                <xsd:enumeration value="CREST"/>
                <xsd:enumeration value="IMPORTANT"/>
                <xsd:enumeration value="STOP"/>
                <xsd:enumeration value="FENCE"/>
                <xsd:enumeration value="BARBED_FENCE"/>
                <xsd:enumeration value="HOLE"/>
                <xsd:enumeration value="COLLAPSE"/>
                <xsd:enumeration value="RUTS"/>
                <xsd:enumeration value="TWISTY"/>
                <xsd:enumeration value="BUMPY_BROKEN"/>
                <xsd:enumeration value="BUMPY"/>
                <xsd:enumeration value="LATERAL_INCLINATION"/>
                <xsd:enumeration value="POST"/>
                <xsd:enumeration value="ELECTRIC_POLE"/>
                <xsd:enumeration value="ELECTRIC_LINE"/>
                <xsd:enumeration value="HIGH_VOLTAGE_TOWER"/>
                <xsd:enumeration value="ANTENNA"/>
                <xsd:enumeration value="WELL"/>
                <xsd:enumeration value="TANKS"/>
                <xsd:enumeration value="BARRELS"/>
                <xsd:enumeration value="NOTABLE_ELEMENTS"/>
                <xsd:enumeration value="TIRES"/>
                <xsd:enumeration value="SIGN_POSTS"/>
                <xsd:enumeration value="RESTRICTED_AREA"/>
                <xsd:enumeration value="BUILDINGS"/>
                <xsd:enumeration value="CHURCH"/>
                <xsd:enumeration value="RUIN"/>
                <xsd:enumeration value="FORT"/>
                <xsd:enumeration value="CEMETERY"/>
                <xsd:enumeration value="VILLAGE"/>
                <xsd:enumeration value="BIVOUAC"/>
                <xsd:enumeration value="PIPELINE"/>
                <xsd:enumeration value="WALL"/>
                <xsd:enumeration value="NATIVE_CAMP"/>
                <xsd:enumeration value="PETROL_STATION"/>
                <xsd:enumeration value="MONUMENT"/>
                <xsd:enumeration value="ANIMAL"/>
                <xsd:enumeration value="ANIMALS"/>
                <xsd:enumeration value="CAIRN"/>
                <xsd:enumeration value="ROCKS"/>
                <xsd:enumeration value="MOUNTAIN"/>
                <xsd:enumeration value="TREE"/>
                <xsd:enumeration value="PALM_TREE"/>
                <xsd:enumeration value="CAMEL_GRASS"/>
                <xsd:enumeration value="VEGETATION"/>
                <xsd:enumeration value="SLOPE"/>
                <xsd:enumeration value="SMALL_WADI"/>
                <xsd:enumeration value="LARGE_WADI"/>
                <xsd:enumeration value="SANDY_WADI"/>
                <xsd:enumeration value="RIVER"/>
                <xsd:enumeration value="LAKE"/>
                <xsd:enumeration value="PLAIN"/>
                <xsd:enumeration value="TOWARDS"/>
                <xsd:enumeration value="ROAD_WORKS"/>
                <xsd:enumeration value="RESET_TRIP"/>
                <xsd:enumeration value="SANDY_PLAIN"/>
                <xsd:enumeration value="BIG_BOWL"/>
                <xsd:enumeration value="SAND_SPIT"/>
                <xsd:enumeration value="DUNE"/>
                <xsd:enumeration value="BROKEN_DUNE"/>
                <xsd:enumeration value="DUNES"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:attribute>
          <xsd:attribute name="place" use="required">
            <xsd:simpleType>
              <xsd:restriction base="xsd:token">
                <xsd:enumeration value="ENTRY"/>
                <xsd:enumeration value="EXIT"/>
                <xsd:enumeration value="FREE"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:attribute>
          <xsd:attribute name="x" type="diagramCoordinate"/>
          <xsd:attribute name="y" type="diagramCoordinate"/>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="danger">
      <xsd:simpleType>
        <xsd:restriction base="xsd:int">
          <xsd:minInclusive value="1"/>
          <xsd:maxInclusive value="3"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="abbreviations">
      <xsd:simpleType>
        <xsd:restriction>
          <xsd:simpleType>
            <xsd:list itemType="abbreviationType"/>
          </xsd:simpleType>
          <xsd:minLength value="1"/>
          <xsd:maxLength value="6"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="text">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:pattern value="[ -~]{1,32}"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
  </xsd:complexType>
  <xsd:simpleType name="diagramCoordinate">
    <xsd:restriction base="xsd:double">
      <xsd:minInclusive value="-1"/>
      <xsd:maxInclusive value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="abbreviationType">
    <xsd:restriction base="xsd:token">
      <xsd:enumeration value="TRACK"/>
      <xsd:enumeration value="PRINCIPAL_TRACK"/>
      <xsd:enumeration value="ROAD"/>
      <xsd:enumeration value="PARALLEL_TRACK"/>
      <xsd:enumeration value="OFF_TRACK"/>
      <xsd:enumeration value="FOLLOW_PRINCIPAL_TRACK"/>
      <xsd:enumeration value="FOLLOW_ROAD"/>
      <xsd:enumeration value="SANDY"/>
      <xsd:enumeration value="GRAVEL"/>
      <xsd:enumeration value="VEGETATION"/>
      <xsd:enumeration value="LEFT_AND_RIGHT"/>
      <xsd:enumeration value="RIGHT_AND_LEFT"/>
      <xsd:enumeration value="ON_LEFT"/>
      <xsd:enumeration value="ON_RIGHT"/>
      <xsd:enumeration value="KEEP_LEFT"/>
      <xsd:enumeration value="KEEP_RIGHT"/>
      <xsd:enumeration value="KEEP_STRAIGHT"/>
      <xsd:enumeration value="LESS_VISIBLE"/>
      <xsd:enumeration value="MORE_OR_LESS_VISIBLE"/>
      <xsd:enumeration value="ALTERNANCE"/>
      <xsd:enumeration value="DURING"/>
      <xsd:enumeration value="INTO"/>
      <xsd:enumeration value="AND_NEXT"/>
      <xsd:enumeration value="AT"/>
      <xsd:enumeration value="STONY"/>
      <xsd:enumeration value="NARROW"/>
      <xsd:enumeration value="QUIT"/>
      <xsd:enumeration value="ALWAYS"/>
      <xsd:enumeration value="MANY"/>
      <xsd:enumeration value="IMPERATIVE"/>
      <xsd:enumeration value="COLLAPSED"/>
      <xsd:enumeration value="RUTS"/>
      <xsd:enumeration value="BAD"/>
      <xsd:enumeration value="REJOIN"/>
      <xsd:enumeration value="BETWEEN"/>
      <xsd:enumeration value="BIG"/>
      <xsd:enumeration value="SMALL"/>
      <xsd:enumeration value="FOLLOW"/>
      <xsd:enumeration value="DUNE"/>
      <xsd:enumeration value="MANY_DUNES"/>
      <xsd:enumeration value="SMALL_DUNE"/>
      <xsd:enumeration value="DUNES_LEVEL_1"/>
      <xsd:enumeration value="DUNES_LEVEL_2"/>
      <xsd:enumeration value="DUNES_LEVEL_3"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="tulipType">
    <xsd:attribute name="shape" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:token">
          <xsd:enumeration value="CROSSING"/>
          <xsd:enumeration value="COUNTERCLOCKWISE_ROUNDABOUT"/>
          <xsd:enumeration value="CLOCKWISE_ROUNDABOUT"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="entry" type="branchKindType" use="required"/>
    <xsd:attribute name="angles" use="required">
      <xsd:simpleType>
        <xsd:restriction>
          <xsd:simpleType>
            <xsd:list>
              <xsd:simpleType>
                <xsd:restriction base="xsd:int">
                  <xsd:minInclusive value="-179"/>
                  <xsd:maxInclusive value="179"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:list>
          </xsd:simpleType>
          <xsd:minLength value="1"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="kinds" use="required">
      <xsd:simpleType>
        <xsd:restriction>
          <xsd:simpleType>
            <xsd:list itemType="branchKindType"/>
          </xsd:simpleType>
          <xsd:minLength value="1"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="exit" type="xsd:nonNegativeInteger" use="required"/>
  </xsd:complexType>

  <xsd:simpleType name="branchKindType">
    <xsd:restriction base="xsd:token">
      <xsd:enumeration value="TARMAC"/>
      <xsd:enumeration value="TRACK"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="nonNegativeDouble">
    <xsd:restriction base="xsd:double">
      <xsd:minInclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="indicesType">
    <xsd:list itemType="xsd:positiveInteger"/>
  </xsd:simpleType>

</xsd:schema>
