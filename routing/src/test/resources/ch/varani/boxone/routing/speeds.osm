<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6" generator="Box One tests">
  <!-- A road from the west to the east, its speed limits changing along it -->
  <node id="1" version="1" lat="46.7000000" lon="6.4000000"/>
  <node id="2" version="1" lat="46.7000000" lon="6.4020000"/>
  <node id="3" version="1" lat="46.7000000" lon="6.4040000"/>
  <node id="4" version="1" lat="46.7000000" lon="6.4060000"/>
  <node id="5" version="1" lat="46.7000000" lon="6.4080000"/>
  <node id="6" version="1" lat="46.7000000" lon="6.4100000"/>
  <node id="7" version="1" lat="46.7000000" lon="6.4120000"/>
  <node id="8" version="1" lat="46.7000000" lon="6.4140000"/>
  <!-- 80 km/h both ways -->
  <way id="1" version="1">
    <nd ref="1"/>
    <nd ref="2"/>
    <nd ref="3"/>
    <tag k="highway" v="secondary"/>
    <tag k="maxspeed" v="80"/>
  </way>
  <!-- 60 km/h to the east, 40 km/h to the west -->
  <way id="2" version="1">
    <nd ref="3"/>
    <nd ref="4"/>
    <nd ref="5"/>
    <tag k="highway" v="secondary"/>
    <tag k="maxspeed:forward" v="60"/>
    <tag k="maxspeed:backward" v="40"/>
  </way>
  <!-- No limit given -->
  <way id="3" version="1">
    <nd ref="5"/>
    <nd ref="6"/>
    <tag k="highway" v="unclassified"/>
  </way>
  <!-- No limit at all -->
  <way id="4" version="1">
    <nd ref="6"/>
    <nd ref="7"/>
    <nd ref="8"/>
    <tag k="highway" v="primary"/>
    <tag k="maxspeed" v="none"/>
  </way>
</osm>
